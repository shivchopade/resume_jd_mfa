# Copy this file to .env and change what you need:   cp .env.example .env
# Every setting is optional - the project runs without a .env file.
# Never commit your real .env (it is in .gitignore).

# --- Signal 1: embedding model (SBERT or BGE) -------------------------------
# Rebuild after changing it:  docker compose up --build
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Fusion weights (they are rescaled to add up to 1) -----------------------
W_SEMANTIC=0.5
W_LEXICAL=0.3
W_LLM=0.2

# --- Signal 2: LLM evaluation (optional) -------------------------------------
# Any OpenAI-compatible chat API. Empty key = LLM signal off.
LLM_API_KEY=
LLM_MODEL=
# xAI Grok (default):    LLM_BASE_URL=https://api.x.ai/v1
# OpenAI:                LLM_BASE_URL=https://api.openai.com/v1
# Groq:                  LLM_BASE_URL=https://api.groq.com/openai/v1
# Ollama on your laptop: LLM_BASE_URL=http://host.docker.internal:11434/v1  (any non-empty key)
LLM_BASE_URL=https://api.x.ai/v1
